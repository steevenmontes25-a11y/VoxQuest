APP_NAME=VoxQuest
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL is required (the app relies on pgsql-specific behaviour is minimal,
# but MySQL is not supported/tested).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=voxquest
DB_USERNAME=voxquest
DB_PASSWORD=voxquest

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# 'redis' (recommended for leaderboards) or 'database' as a zero-setup fallback.
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@voxquest.app"
MAIL_FROM_NAME="${APP_NAME}"

# --- VoxQuest ---
# Comma-separated PWA origins allowed to call the API (dev + prod).
VOXQUEST_FRONTEND_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
# Require a verified email before the API accepts writes (non-blocking while false).
VOXQUEST_REQUIRE_EMAIL_VERIFICATION=false
# Forgiven days when a daily streak lapses (0 disables the grace rule).
VOXQUEST_STREAK_GRACE_DAYS=1

SANCTUM_STATEFUL_DOMAINS=

VITE_APP_NAME="${APP_NAME}"
